/* Metallic themes — dark is the default. */
:root{color-scheme:dark;--metal:#d9dde1;--metal-bright:#fff;--metal-shadow:#89919a;--surface:#181c20;--surface-2:#22282e;--line:#39414a;--ink:#eef1f4;--muted:#a4adb6;--accent:#dce2e7;--accent-ink:#15191d}html[data-theme="dark"] body,html[data-theme="dark"] .app{background:radial-gradient(circle at 80% -10%,#3b4651 0,transparent 34%),#0b0d10;color:var(--ink)}html[data-theme="dark"] .app{background:radial-gradient(circle at 80% -10%,#3b4651 0,transparent 34%),#0b0d10}html[data-theme="dark"] .brand-mark{color:var(--metal-bright);border-color:var(--metal);background:linear-gradient(145deg,#fff,#89919a);-webkit-background-clip:text;background-clip:text}html[data-theme="dark"] .tag,.eyebrow,html[data-theme="dark"] .text-button,html[data-theme="dark"] nav button.on,html[data-theme="dark"] .add-set,html[data-theme="dark"] .done{color:var(--metal)}html[data-theme="dark"] .program-card,html[data-theme="dark"] .exercise,html[data-theme="dark"] .history-card,html[data-theme="dark"] .profile-card,html[data-theme="dark"] .coach-card,html[data-theme="dark"] .scan-capture,html[data-theme="dark"] .last-session,html[data-theme="dark"] .weight-chart{background:linear-gradient(135deg,#262d33,#15191d);border-color:var(--line)}html[data-theme="dark"] .program-icon,html[data-theme="dark"] .finish,html[data-theme="dark"] .finish-wide,html[data-theme="dark"] .coach-save,html[data-theme="dark"] .coach-start,html[data-theme="dark"] .rest-actions .rest-toggle,html[data-theme="dark"] .weigh-in button{background:linear-gradient(145deg,#f7f9fa,#9aa3ac);color:var(--accent-ink);border-color:#d7dde1}html[data-theme="dark"] .check.checked,html[data-theme="dark"] .readiness-row button.selected{background:linear-gradient(145deg,#f7f9fa,#9aa3ac);border-color:#d7dde1;color:var(--accent-ink)}html[data-theme="dark"] .recommendation{background:linear-gradient(135deg,#3a444e,#171c21);border-color:#687480}html[data-theme="dark"] .goal-card,html[data-theme="dark"] .rest-timer{background:linear-gradient(135deg,#39434c,#181d22);border-color:#77838e}html[data-theme="dark"] .chart-line,html[data-theme="dark"] .chart-dot,html[data-theme="dark"] .weekly-progress i.complete{stroke:#e8edf0;fill:#e8edf0;background:#e8edf0}html[data-theme="dark"] .coach-tips{border-color:#dce2e7}
.header-actions{display:flex;align-items:center;gap:9px}.theme-toggle{border:1px solid #6d7781;border-radius:9px;background:linear-gradient(145deg,#313a43,#171b20);color:#edf1f3;padding:7px 9px;font-size:11px;font-weight:900;white-space:nowrap}
html[data-theme="light"]{color-scheme:light}html[data-theme="light"] body,html[data-theme="light"] .app{background:radial-gradient(circle at 80% -10%,#fff 0,transparent 32%),linear-gradient(145deg,#eef1f3,#bac1c8);color:#182027}html[data-theme="light"] .app{background:radial-gradient(circle at 80% -10%,#fff 0,transparent 32%),linear-gradient(145deg,#eef1f3,#bac1c8)}html[data-theme="light"] .brand-mark{color:#303a43;border-color:#77818a;background:linear-gradient(145deg,#fff,#a4adb5);-webkit-background-clip:text;background-clip:text}html[data-theme="light"] .tag,html[data-theme="light"] .eyebrow,html[data-theme="light"] .text-button,html[data-theme="light"] nav button.on,html[data-theme="light"] .add-set,html[data-theme="light"] .done{color:#46515a}html[data-theme="light"] .muted,html[data-theme="light"] .last-session span,html[data-theme="light"] .history-card p,html[data-theme="light"] .saved{color:#59636d}html[data-theme="light"] .program-card,html[data-theme="light"] .exercise,html[data-theme="light"] .history-card,html[data-theme="light"] .profile-card,html[data-theme="light"] .coach-card,html[data-theme="light"] .scan-capture,html[data-theme="light"] .last-session,html[data-theme="light"] .weight-chart,html[data-theme="light"] .scan-viewer,html[data-theme="light"] .scan-empty{background:linear-gradient(145deg,#fff,#d5dbe0);border-color:#aab2ba;color:#192027;box-shadow:0 8px 24px #73808c30}html[data-theme="light"] .set-row input,html[data-theme="light"] .profile-card input,html[data-theme="light"] .profile-card select,html[data-theme="light"] .editor input,html[data-theme="light"] .weigh-in input{background:#f8fafb;color:#182027;border-color:#9ea8b1}html[data-theme="light"] .workout header,html[data-theme="light"] nav{background:#e7ebeeee;border-color:#abb3ba}html[data-theme="light"] .finish,html[data-theme="light"] .finish-wide,html[data-theme="light"] .coach-save,html[data-theme="light"] .coach-start,html[data-theme="light"] .weigh-in button,html[data-theme="light"] .program-icon{background:linear-gradient(145deg,#4e5963,#172027);color:#fff}html[data-theme="light"] .check.checked,html[data-theme="light"] .readiness-row button.selected{background:#313c46;border-color:#313c46;color:#fff}html[data-theme="light"] .last,html[data-theme="light"] .coach-tips{background:#e6eaed;color:#263039}html[data-theme="light"] .theme-toggle{background:linear-gradient(145deg,#fff,#b3bbc2);border-color:#89939b;color:#222b32}html[data-theme="light"] .scan-tabs button.on{background:#4c5862;color:#fff}html[data-theme="light"] .rest-timer,html[data-theme="light"] .goal-card,html[data-theme="light"] .recommendation{background:linear-gradient(135deg,#f9fafb,#c5cdd3);border-color:#909aa3;color:#182027}
